{
  "name": "gh-cp-chat-analyser",
  "private": true,
  "version": "0.1.0",
  "description": "GitHub Copilot Chat Session Analyser — monorepo root",
  "type": "module",
  "workspaces": [
    "packages/domain",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/server & npm run dev --workspace=packages/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.20.1",
    "eslint": "^9.15.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
